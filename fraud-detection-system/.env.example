# Optional: the stack runs without a .env file, using the local development
# defaults in docker-compose.system.yml. Create a .env only to override them,
# and always override them outside your own machine.
#
# 1. Copy this file to .env (in this directory)
# 2. Replace the placeholder values
# 3. Never commit the .env file to Git

# Grafana login (default: admin / admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-secure-password

# Postgres, fraud alerts (default: fraud_user / fraud-dev-password)
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change-me-to-secure-password

# Lakehouse object storage, SeaweedFS S3 (default: lakehouse / lakehouse-secret)
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-to-secure-password

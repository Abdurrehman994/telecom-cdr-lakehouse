        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Dead letters (1h)",
      "description": "Messages sent to cdr-events-dlq in the last hour",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(delta(kafka_topic_partition_current_offset{topic=\"cdr-events-dlq\"}[1h]))",
          "instant": false

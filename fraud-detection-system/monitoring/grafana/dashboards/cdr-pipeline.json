    {
      "type": "timeseries",
      "title": "Fallbacks and redeliveries",
      "description": "Uncertain CDRs scored without the LLM, and redelivered CDRs whose alert already existed",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_skipped_total[1m]))",
          "legendFormat": "LLM skipped (circuit open)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(duplicate_alerts_skipped_total[1m]))",
          "legendFormat": "duplicate alerts skipped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: CDRs/s",
          "custom": {
            "lineWidth": 2,
